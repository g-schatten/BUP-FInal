# simulator-api (see problem/BUP_Fuel_Supply_Simulator_Integration_Guide_Final.pdf)
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

# backend (SIMULATOR_BASE_URL is set by docker-compose for container-to-container calls;
# override here only for `uvicorn --reload` dev outside Docker, e.g. http://localhost:8000)
SIMULATOR_BASE_URL=http://localhost:8000

# frontend
VITE_BACKEND_URL=http://localhost:8080
